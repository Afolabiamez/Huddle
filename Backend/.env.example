# Local development database from docker-compose.yml (host port 5434).
DATABASE_URL=postgresql://huddle:huddle_local_pw@localhost:5434/huddle_db
# At least 32 UTF-8 bytes. Generate a random secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=3000
NODE_ENV=development
